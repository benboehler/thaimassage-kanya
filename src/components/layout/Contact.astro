---
---
<section id="kontakt" class="px-4 sm:px-6 lg:px-8 py-20 bg-massage-pale">
    <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mx-auto">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-4xl font-bold text-foreground">Kontakt</h2>
                <div class="mt-2 h-1 w-20 bg-massage-primary mx-auto rounded-full"></div>
            </div>

            <div class="bg-white rounded-3xl shadow-xl p-8 md:p-12 border border-massage-primary/10">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                    <div class="space-y-8">
                        <div>
                            <h3 class="text-2xl font-bold text-massage-primary mb-2">Thaimassage Kanya</h3>
                        </div>

                        <div class="space-y-4">
                            <div class="flex items-start gap-x-4">
                                <div class="mt-1 text-massage-primary">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-medium text-foreground">Hauptstrasse 51</p>
                                    <p class="text-muted-foreground">5330 Bad Zurzach, Schweiz</p>
                                </div>
                            </div>

                            <div class="flex items-center gap-x-4">
                                <div class="text-massage-primary">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                    </svg>
                                </div>
                                <a href="tel:+41765788999"
                                   class="text-muted-foreground hover:text-massage-primary transition-colors">+41 76 578
                                    89 99</a>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <h4 class="text-xl font-bold text-foreground border-b border-massage-primary/10 pb-2">
                            Öffnungszeiten TBD</h4>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="text-muted-foreground">Montag – Freitag</span>
                                <span class="font-medium text-foreground">09:00 – 19:00 Uhr</span>
                            </div>
                            <div class="flex justify-between items-center border-t border-massage-primary/5 pt-3">
                                <span class="text-muted-foreground">Samstag</span>
                                <span class="font-medium text-foreground">10:00 – 16:00 Uhr</span>
                            </div>
                            <div class="flex justify-between items-center border-t border-massage-primary/5 pt-3">
                                <span class="text-muted-foreground">Sonntag</span>
                                <span class="font-medium text-foreground italic">Geschlossen</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-12 rounded-2xl overflow-hidden shadow-inner border border-massage-primary/10">
                    <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2690.945388191664!2d8.29298407605575!3d47.58830428924123!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x479068d947d57b4b%3A0xf4f387b376981317!2sCreaOcchio%20GmbH!5e0!3m2!1sde!2sch!4v1785417623633!5m2!1sde!2sch"
                            width="100%"
                            height="400"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            class="w-full"
                    ></iframe>
                </div>

                <div class="mt-12 pt-8 border-t border-massage-primary/10 text-center">
                    <p class="text-lg text-muted-foreground italic">
                        Vereinbaren Sie noch heute Ihren Termin und gönnen Sie sich eine wohltuende Pause vom Alltag.
                    </p>
                    <div class="mt-6">
                        <a href="mailto:info@creamassage.ch"
                           class="inline-flex items-center justify-center px-8 py-3 bg-massage-primary text-white font-medium rounded-2xl hover:bg-opacity-90 transition-all shadow-md">
                            Termin anfragen TBD
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
