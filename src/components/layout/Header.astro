<!-- ========== HEADER ========== -->
<header class="fixed top-0 inset-x-0 z-50 w-full text-sm px-4">
    <nav class="mt-4 relative max-w-2xl w-full bg-massage-pale/90 backdrop-blur-md border border-massage-primary/20 shadow-lg rounded-3xl mx-auto flex flex-wrap md:flex-nowrap items-center justify-between p-1 ps-4 md:py-0">
        <div class="flex items-center">
            <!-- Logo -->
            <a class="flex-none rounded-md text-xl inline-block font-semibold focus:outline-hidden focus:opacity-80"
               href="/#home" aria-label="Massage Studio Logo">
                <div class="flex items-center gap-x-2 py-2 text-massage-primary">
                    <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C7.58 2 4 5.58 4 10C4 14.42 7.58 18 12 18C16.42 18 20 14.42 20 10C20 5.58 16.42 2 12 2ZM12 16C8.69 16 6 13.31 6 10C6 6.69 8.69 4 12 4C15.31 4 18 6.69 18 10C18 13.31 15.31 16 12 16Z"
                              fill="currentColor"/>
                        <path d="M12 6C9.79 6 8 7.79 8 10C8 12.21 9.79 14 12 14C14.21 14 16 12.21 16 10C16 7.79 14.21 6 12 6ZM12 12C10.9 12 10 11.1 10 10C10 8.9 10.9 8 12 8C13.1 8 14 8.9 14 10C14 11.1 13.1 12 12 12Z"
                              fill="currentColor"/>
                        <path d="M12 20C7.58 20 4 21.79 4 24H20C20 21.79 16.42 20 12 20Z" fill="currentColor"/>
                    </svg>
                    <span class="text-lg font-bold tracking-tight">CreaMassage</span>
                </div>
            </a>
            <!-- End Logo -->
        </div>

        <div class="flex items-center gap-1 md:order-4 md:ms-4">
            <a class="w-full sm:w-auto whitespace-nowrap py-2 px-3 inline-flex justify-center items-center gap-x-2 text-sm font-medium rounded-3xl bg-massage-primary border border-massage-primary/20 text-white hover:opacity-90 transition-opacity focus:outline-hidden disabled:opacity-50 disabled:pointer-events-none"
               href="mailto:info@creamassage.ch">
                Termin anfragen
            </a>

            <div class="md:hidden">
                <!-- Toggle Button -->
                <button type="button"
                        class="hs-collapse-toggle flex justify-center items-center size-9 bg-massage-pale border border-massage-primary/10 text-massage-primary rounded-full hover:bg-massage-primary/5 focus:outline-hidden"
                        id="hs-pro-pnm-collapse" aria-expanded="false" aria-controls="hs-pro-pnm"
                        aria-label="Toggle navigation" data-hs-collapse="#hs-pro-pnm">
                    <svg class="hs-collapse-open:hidden shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24"
                         height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" x2="21" y1="6" y2="6"/>
                        <line x1="3" x2="21" y1="12" y2="12"/>
                        <line x1="3" x2="21" y1="18" y2="18"/>
                    </svg>
                    <svg class="hs-collapse-open:block hidden shrink-0 size-4" xmlns="http://www.w3.org/2000/svg"
                         width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18"/>
                        <path d="m6 6 12 12"/>
                    </svg>
                </button>
                <!-- End Toggle Button -->
            </div>
        </div>

        <div id="hs-pro-pnm"
             class="hidden hs-collapse overflow-hidden transition-all duration-300 basis-full grow md:block"
             aria-labelledby="hs-pro-pnm-collapse" role="region">
            <div class="flex flex-col md:flex-row md:items-center md:justify-end gap-2 md:gap-3 mt-3 md:mt-0 py-2 md:py-0 md:ps-7 px-2">
                <a class="nav-link py-2 md:py-3 px-4 md:px-1 border-s-2 md:border-s-0 md:border-b-2 hover:text-massage-primary focus:outline-hidden border-transparent text-massage-primary/80 transition-colors"
                   href="/#ueber-uns">Über uns</a>
                <a class="nav-link py-2 md:py-3 px-4 md:px-1 border-s-2 md:border-s-0 md:border-b-2 hover:text-massage-primary focus:outline-hidden border-transparent text-massage-primary/80 transition-colors"
                   href="/#angebot">Angebot</a>
                <a class="nav-link py-2 md:py-3 px-4 md:px-1 border-s-2 md:border-s-0 md:border-b-2 hover:text-massage-primary focus:outline-hidden border-transparent text-massage-primary/80 transition-colors"
                   href="/#kontakt">Kontakt</a>
            </div>
        </div>
    </nav>
</header>
<!-- ========== END HEADER ========== -->